{
  "name": "kostan-bagaskaraap-dev",
  "version": "2.0.0",
  "description": "Sistem Manajemen & Reservasi Kostan Modern Full-Stack (Docker, React, Tailwind, Node.js Express, SQLite, Image Extension)",
  "main": "backend/src/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "test": "node --check backend/src/server.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "kostan",
    "docker",
    "react",
    "tailwind",
    "express",
    "sqlite",
    "vibe-coding",
    "antigravity"
  ],
  "author": "BagaskaraAP-Dev",
  "license": "MIT"
}
